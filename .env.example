# Copia este archivo como ".env" (mismo nombre, sin ".example") y completa lo que necesites.
# Sin este archivo el proyecto funciona igual en MODO LOCAL (sin internet ni Firebase).

# --- Firebase Realtime Database (ver docs/firebase.md) ---
AQ_FIREBASE_URL=https://TU-PROYECTO-default-rtdb.firebaseio.com
# Archivo de la cuenta de servicio descargado desde la consola de Firebase (por defecto: firebase-credenciales.json)
# AQ_FIREBASE_CREDENCIALES=firebase-credenciales.json
# Carpeta de respaldos automáticos de la base (por defecto: respaldos/). Mejor una carpeta sincronizada fuera del equipo, p. ej.:
# AQ_RESPALDOS_DIR=C:\Users\TU_USUARIO\OneDrive\AquaPlants\respaldos

# --- Simulación y app móvil (opcional) ---
# AQ_SIMULACION=0           # 0 = no iniciar los dispositivos simulados (por ejemplo, con dispositivos reales)
# AQ_SIM_INTERVALO=5        # segundos entre mediciones simuladas
# AQ_DESCUBRIMIENTO=0       # 0 = no avisar a la app móvil en la red local

# --- Acceso (para no perder nunca las cuentas) ---
# Contraseña única de las cuentas demo (admin@, supervisor@, encargado@, encargado2@aquaplants.demo). 12+ caracteres con
# mayúscula, minúscula, número y símbolo. Al iniciar el servidor se aplica a esas cuentas y se quitan los bloqueos.
# AQ_DEMO_PASSWORD=
# Administrador propio opcional (se crea si no existe):
# AQ_BOOTSTRAP_ADMIN_EMAIL=
# AQ_BOOTSTRAP_ADMIN_PASSWORD=
# AQ_DESBLOQUEAR_AL_INICIAR=1     # 1 = quitar bloqueos por intentos fallidos en cada arranque (por defecto en desarrollo)

# --- Relé por Firebase para la app móvil (ver docs/conexion-movil.md) ---
# AQ_RELAY=0                      # 0 = no atender a la app móvil por Firebase
# AQ_PUBLICAR_REGLAS=0            # 0 = no publicar firebase/database.rules.json automáticamente (pegarlas a mano)

# --- Recuperación de contraseña («Olvidé mi contraseña») ---
# Con SMTP configurado se envía el correo con el código. Sin SMTP el mensaje queda en data/correos-salientes.log y en la consola del servidor.
# AQ_SMTP_HOST=smtp.gmail.com
# AQ_SMTP_PORT=587
# AQ_SMTP_USER=
# AQ_SMTP_PASSWORD=
# AQ_SMTP_DE=AquaPlants <no-responder@tudominio.cl>
# AQ_RECUPERACION_DEMO=1          # SOLO demostración sin correo: muestra el código en pantalla. En producción dejarlo en 0.
